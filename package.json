{
  "name": "recording-analysis",
  "version": "0.1.0",
  "bin": {
    "recording-analysis": "bin/recording-analysis.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "cdk:synth": "cdk synth",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cdk:sandbox": "cross-env NODE_ENV=Sandbox CDK_MODE=ONLY_SANDBOX cdk deploy --profile sandbox",
    "cdk:development": "cross-env NODE_ENV=Development CDK_MODE=ONLY_DEVELOPMENT cdk deploy --profile sandbox",
    "cdk:pipeline": "cross-env NODE_ENV=Development CDK_MODE=ONLY_PIPELINE cdk deploy --profile sandbox"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "aws-cdk": "2.173.2",
    "esbuild": "^0.24.2",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.173.2",
    "aws-sdk": "^2.1692.0",
    "constructs": "^10.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7"
  }
}
